#version 460
#extension GL_EXT_ray_query : require

// Dirt (ambient occlusion) for vklight. One invocation per lightmap sample.
// Mirrors LightFace_CalculateDirt (dirtmode 0) and qv::MakeTangentAndBitangentUnnormalized in the
// CPU code; keep them in sync. A sample whose rays meet filtered (non-opaque) geometry gets
// DIRT_NEEDS_CPU and is recomputed on the CPU.

layout(local_size_x = 64) in;

const uint SAMPLE_SKIP = 0xffffffffu;
const float DIRT_NEEDS_CPU = -1.0;

struct Sample {
    vec3 pos; float occlusion;
    vec3 normal; uint face;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(std430, set = 0, binding = 1) readonly buffer Samples { Sample samples[]; };
layout(std430, set = 0, binding = 2) readonly buffer Vectors { vec4 vectors[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Occlusion { float occlusion[]; };

layout(push_constant) uniform PushConstants {
    uint sample_count;
    uint sample_base;
    uint vector_count;
    uint sky_geometry;
    float depth;
} pc;

// qv::MakeTangentAndBitangentUnnormalized, normalized afterwards like LightFace_CalculateDirt
void tangent_basis(vec3 n, out vec3 up, out vec3 rt)
{
    // qv::indexOfLargestMagnitudeComponent: first index with the strictly largest magnitude
    int axis = 0;
    float largest = 0.0;
    for (int i = 0; i < 3; i++) {
        if (abs(n[i]) > largest) {
            largest = abs(n[i]);
            axis = i;
        }
    }
    vec3 a = vec3(0.0);
    vec3 b = vec3(0.0);
    a[(axis + 1) % 3] = 1.0;
    b[(axis + 2) % 3] = 1.0;

    vec3 tangent = cross(n, a);
    vec3 bitangent = cross(n, b);
    if (dot(cross(tangent, bitangent), n) < 0.0) {
        vec3 t = tangent;
        tangent = bitangent;
        bitangent = t;
    }
    up = normalize(tangent);
    rt = normalize(bitangent);
}

void main()
{
    uint sid = pc.sample_base + gl_GlobalInvocationID.x;
    if (sid >= pc.sample_count)
        return;

    Sample s = samples[sid];
    if (s.face == SAMPLE_SKIP) {
        // occluded samples trace no rays: average hit distance 0 -> fully occluded
        occlusion[sid] = 1.0;
        return;
    }

    vec3 up, rt;
    tangent_basis(s.normal, up, rt);

    float total = 0.0;
    for (uint j = 0u; j < pc.vector_count; ++j) {
        vec3 v = vectors[j].xyz;
        // TransformToTangentSpace
        vec3 dir = rt * v.x + up * v.y + s.normal * v.z;

        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, scene, gl_RayFlagsNoneEXT, 0xff, s.pos, 0.0, dir, pc.depth);
        float filtered_t = 1e30;
        while (rayQueryProceedEXT(rq)) {
            filtered_t = min(filtered_t, rayQueryGetIntersectionTEXT(rq, false));
        }

        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            if (filtered_t < 1e30) {
                occlusion[sid] = DIRT_NEEDS_CPU;
                return;
            }
            total += pc.depth;
            continue;
        }
        float t = rayQueryGetIntersectionTEXT(rq, true);
        if (filtered_t < t) {
            occlusion[sid] = DIRT_NEEDS_CPU;
            return;
        }
        if (rayQueryGetIntersectionGeometryIndexEXT(rq, true) == pc.sky_geometry)
            total += pc.depth; // sky is not a SOLID hit
        else
            total += min(pc.depth, t);
    }

    float avg_hitdist = total / float(pc.vector_count);
    occlusion[sid] = 1.0 - (avg_hitdist / pc.depth);
}
